{
  "name": "react-ts",
  "version": "0.1.0",
  "description": "React TypeScript Webpack setup for 2025",
  "main": "main/index.js",
  "productName": "Some new app",
  "scripts": {
    "bd": "npm run build && npm run deploy",
    "build": "npm run build:web && npm run build:electron",
    "build:web": "webpack --config ./webpack.config.prod.js",
    "build:electron": "electron-builder",
    "deploy": "./scripts/deploy.sh",
    "dev:electron": "wait-on tcp:7000 && electron .",
    "images": "./scripts/images.sh",
    "start": "webpack s --config ./webpack.config.dev.js",
    "test": "jest"
  },
  "keywords": [
    "react",
    "webpack"
  ],
  "author": "Chris Hammock",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "qs": "^6.16.0",
    "ramda": "^0.32.0",
    "ramjam": "^1.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "socket.io-client": "^4.8.3",
    "use-ls": "^0.0.6",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/ramda": "^0.32.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "concurrently": "^10.0.5",
    "css-loader": "^7.1.5",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-is-dev": "^3.0.1",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.5.2",
    "jest-css-modules": "^2.1.0",
    "jest-environment-jsdom": "^30.5.2",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "wait-on": "^9.1.0",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  },
  "build": {
    "appId": "com.ptelex.react-ts",
    "productName": "React App",
    "files": [
      "dist/**/*",
      "main/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist/electron"
    },
    "mac": {
      "identity": null
    }
  }
}
